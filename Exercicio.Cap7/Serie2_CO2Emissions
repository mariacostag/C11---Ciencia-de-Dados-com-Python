#Importando as bibliotecas necessárias
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from statsmodels.tsa.seasonal import seasonal_decompose


#Série 2: C02 Emissions
#Carregando o dataset necessário
co2 = pd.read_csv('co2_emissions.csv',
                  index_col='Year')

#Transformando o índice (ano) em data e os dados de y em float
co2.index = pd.to_datetime(co2.index, format='%Y')
co2['CO2_Emissions'] = co2['CO2_Emissions'].astype(float)

#Plotando a Time Series
co2['CO2_Emissions'].plot(figsize=(8, 6),
                          title='Emissões de CO2 por ano',
                          xlabel='Ano',
                          ylabel='Emissões de CO2',
                          x_compat=True)

#Fazendo a decomposição aditiva
#Os dados são anuais, então usamos period=8 para separar tendência e ciclo
decomposition_co2 = seasonal_decompose(co2['CO2_Emissions'],
                                       model='additive',
                                       period=8)

# Plotando os componentes
decomposition_co2.plot()
plt.tight_layout()

