'''
1. Por meio do dataset paises.csv, trace dois gráficos de linhas em um mesmo plano cartesiano, um 
mostrando a taxa de mortalidade (Deathrate) e outro a taxa de natalidade (Birthrate) dos países da 
América do Norte.
'''

#Importando as bibliotecas
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

#Importando o dataset
dataset = pd.read_csv('paises.csv', delimiter=';')

#Limpando espaços extras das colunas de texto
paises = dataset['Country'].str.strip()
regiao = dataset['Region'].str.strip()

#Separando os países da América do Norte
america_norte = dataset[regiao == 'NORTHERN AMERICA']
paises = america_norte['Country']

#Separando as taxas de mortalidade e natalidade
mortalidade = america_norte['Deathrate']
natalidade = america_norte['Birthrate']

#Ajustando o tamanho do gráfico
plt.figure(figsize=(10, 6))

#Traçando os dois gráficos de linha
plt.plot(paises, mortalidade, '*:r', linewidth=3, markersize=20, label='Mortalidade (Deathrate)')
plt.plot(paises, natalidade, 's--b', linewidth=3, markersize=20, label='Natalidade (Birthrate)')

plt.xlabel('País')
plt.ylabel('Taxa (por 1000 habitantes)')

#Legenda sobre cada gráfico
plt.legend()
