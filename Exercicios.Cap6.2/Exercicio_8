'''
8. Por meio do dataset space.csv, após filtrar apenas as missões com custo conhecido (Cost > 0), trace 
um Boxplot comparando a distribuição de custo das missões (Cost) entre foguetes com status "StatusActive"
 e "StatusRetired", permitindo identificar mediana, dispersão e outliers de cada grupo.
'''

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

#Importando o dataset desejado
ds_space = pd.read_csv('space.csv', delimiter=';')

#Eliminando espaços nos nomes das colunas
ds_space.columns = ds_space.columns.str.strip()

#Filtra apenas as missões com custo conhecido
ds_space = ds_space[ds_space['Cost'] > 0]

#Traçando o grafico boxplot
sns.boxplot(data=ds_space, 
            x='Status Rocket', 
            y='Cost')
plt.title('Custo das missões: foguetes ativos x aposentados')
plt.ylabel('Custo (milhões de US$)')
plt.show()
