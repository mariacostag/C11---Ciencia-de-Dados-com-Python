'''
6. Com o dataset paises.csv, trace um Boxplot comparando a distribuição do "GPD ($ per capita)" entre 
os países da América Latina e da Europa Ocidental, permitindo assim identificar mediana, dispersão e 
outliers de cada grupo.
'''

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

#Importando o dataset desejado
ds_paises = pd.read_csv('paises.csv', delimiter=';')

#Filtrando a coluna desejada
#Os nomes das regiões possuem espaços faltando
ds_paises['Region'] = ds_paises['Region'].str.strip()

regioes = ds_paises[ds_paises['Region'].isin(['LATIN AMER. & CARIB', 'WESTERN EUROPE'])]

#Traçando o grafico boxplot
sns.boxplot(data=regioes, 
            x='Region', 
            y='GDP ($ per capita)')
plt.title('GDP per capita: América Latina x Europa Ocidental')
plt.show()
