'''
5. Utilizando o dataset paises.csv, calcule a correlação entre "GPD ($ per capita)", "Literacy (%)", 
"Infant mortality (per 1000 births)" e "Phones (per 1000)", apresentando o resultado em um Heatmap 
com os valores numéricos exibidos.
'''

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

#Importando o dataset desejado
ds_paises = pd.read_csv('paises.csv', delimiter=';')

#Filtrando os dados desejados
colunas = ['GDP ($ per capita)', 'Literacy (%)',
           'Infant mortality (per 1000 births)', 'Phones (per 1000)']

#Verificando e substituindo os valores ausentes
ds_paises[colunas] = ds_paises[colunas].replace(0, float('nan'))

#Traçando o heatmap
corr = ds_paises[colunas].corr()
sns.heatmap(corr, 
            annot=True, 
            fmt='.2f')
plt.title('Correlação entre variáveis')
plt.show()
