#Semente aleatória
np.random.seed(10)

#Criação da matriz
mtz = np.random.randint(1, 51, size = 16)
mtz = (mtz.reshape(4, 4))
print(mtz)

#Média de cada linha e cada coluna
media_coluna = (mtz.sum(axis=0)) / 2
print(media_coluna)

media_linha = (mtz.sum(axis=1)) / 2
print(media_linha)

#Maior média das colunas e das linhas
print("Maior média das colunas:", media_coluna.max())
print("Maior média das linhas:", media_linha.max())

