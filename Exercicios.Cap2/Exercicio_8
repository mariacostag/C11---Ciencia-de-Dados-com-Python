"""
8. Crie um programa que leia dois números calcule e mostre na tela:
• Adição
• Subtração
• Multiplicação
• Divisão
• Resto da divisão
• Potência (primeiro número elevado ao segundo)
"""

#Exercício 8

#Importando a biblioteca
import math

#Entrada de dados
num1 = float(input("Digite o primeiro número: "))
num2 = float(input("Digite o segundo número: "))

#Cálculos das operações e saídas de dados
adicao = num1 + num2
print(f"Adição: {adicao}")

subtracao = num1 - num2
print(f"Subtração: {subtracao}")

multiplicacao = num1 * num2
print(f"Multiplicação: {multiplicacao}")

#Verificação do segundo número e cálcul da divisão
if num2 != 0:
    divisao = num1 / num2
    print(f"Divisão: {divisao}")

    resto = num1 % num2
    print(f"Resto da divisão: {resto}")

else:
    print("Não é possível dividir por zero")

potencia = math.pow(num1, num2)
print(f"Potência: {potencia}")
